<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Claim your exclusive $1000 CashApp or $100 Nike Gift Card today! Simple steps, fast rewards." />
    <title>Exclusive Rewards - Claim Your Gift Card</title>
    
    <style>
        /* --- RESET AND BASE STYLES --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* --- HEADER --- */
        header {
            text-align: center;
            padding: 50px 20px 30px;
        }

        header h1 {
            font-size: 2.5rem;
            margin-bottom: 15px;
            background: linear-gradient(90deg, #00C9FF, #92FE9D);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        header p {
            font-size: 1.1rem;
            color: #b0b0c0;
            max-width: 600px;
            margin: 0 auto;
        }

        .urgency-text {
            margin-top: 15px;
            font-size: 0.95rem;
            color: #ff6b6b;
            font-weight: bold;
        }

        /* --- MAIN CONTAINER --- */
        main {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .offers-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            max-width: 1200px;
            width: 100%;
        }

        /* --- OFFER CARDS --- */
        .offer-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 35px 25px;
            width: 320px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .offer-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .offer-card.highlight {
            border: 2px solid #4CAF50;
            box-shadow: 0 0 20px rgba(76, 175, 80, 0.3);
        }

        .badge {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            background: #4CAF50;
            color: white;
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            white-space: nowrap;
        }

        .badge.android-pc {
            background: #FF9800;
        }

        .recommended-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: #ff4757;
            color: white;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: bold;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .offer-card h2 {
            margin-top: 15px;
            font-size: 1.6rem;
            color: #ffffff;
        }

        .offer-card p {
            margin: 15px 0 25px;
            color: #c0c0d0;
            font-size: 0.95rem;
            line-height: 1.5;
        }

        /* --- CTA BUTTON --- */
        .cta-button {
            display: inline-block;
            background: linear-gradient(90deg, #00C9FF 0%, #92FE9D 100%);
            color: #1a1a2e;
            padding: 16px 30px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 800;
            font-size: 1.1rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .cta-button:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(146, 254, 157, 0.4);
        }

        /* --- FOOTER --- */
        footer {
            text-align: center;
            padding: 30px 20px;
            color: #707080;
            font-size: 0.85rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        footer a {
            color: #92FE9D;
            text-decoration: none;
        }

        /* --- SOCIAL PROOF NOTIFICATION --- */
        .notification {
            position: fixed;
            bottom: 20px;
            left: 20px;
            background: rgba(255, 255, 255, 0.95);
            color: #1a1a2e;
            padding: 15px 20px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            transform: translateX(-150%);
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 1000;
            font-size: 0.9rem;
            border-left: 5px solid #4CAF50;
            max-width: 300px;
        }

        .notification.show {
            transform: translateX(0);
        }

        /* --- RESPONSIVE --- */
        @media (max-width: 768px) {
            header h1 { font-size: 2rem; }
            .offer-card { width: 100%; max-width: 350px; }
            .notification { left: 50%; transform: translateX(-50%) translateY(150%); bottom: 20px; width: 90%; text-align: center; border-left: none; border-bottom: 5px solid #4CAF50; }
            .notification.show { transform: translateX(-50%) translateY(0); }
        }
    </style>
</head>
<body>

    <header>
        <h1>🎉 Exclusive Rewards Await! 🎉</h1>
        <p>Choose your preferred gift card below and follow the simple steps to claim it instantly.</p>
        <div class="urgency-text">🔥 Only <span id="spots-left">7</span> spots remaining for today's promotion!</div>
    </header>

<main>
    <div class="offers-container">
        <!-- Offer 1: Any Device -->
        <div class="offer-card" data-device="all">
            <div class="badge">✅ Any Device</div>
            <h2>$1000 CashApp</h2>
            <p>Get a $1000 CashApp Gift Card sent directly to your account. Quick and easy verification!</p>
            <a href="https://singingfiles.com/show.php?l=0&amp;u=2563520&amp;id=75220" class="cta-button" target="_blank" rel="noopener noreferrer">Claim Now</a>
        </div>

        <!-- Offer 2: Android & PC -->
        <div class="offer-card" data-device="android-pc">
            <div class="badge android-pc">📱💻 Android &amp; PC Only</div>
            <h2>$1000 CashApp</h2>
            <p>Exclusive premium offer for Android and PC users. Higher approval rate!</p>
            <a href="https://singingfiles.com/show.php?l=0&amp;u=2563520&amp;id=75525" class="cta-button" target="_blank" rel="noopener noreferrer">Claim Now</a>
        </div>

        <!-- Offer 3: Android & PC -->
        <div class="offer-card" data-device="android-pc">
            <div class="badge android-pc">📱💻 Android &amp; PC Only</div>
            <h2>$100 Nike Gift Card</h2>
            <p>Step up your game! Claim a $100 Nike Gift Card and shop your favorite gear.</p>
            <a href="https://singingfiles.com/show.php?l=0&amp;u=2563520&amp;id=75217" class="cta-button" target="_blank" rel="noopener noreferrer">Claim Now</a>
        </div>
    </div>
</main>

    <footer>
        <p>2026 Exclusive Rewards. All rights reserved.</p>
        <p><small>Disclaimer: This website contains affiliate links. We may receive a commission if you complete an offer. This is not affiliated with or endorsed by CashApp or Nike.</small></p>
    </footer>

    <!-- Social Proof Notification Container -->
    <div id="notification-container"></div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. URGENCY: Randomize spots left between 3 and 12
            const spots = Math.floor(Math.random() * (12 - 3 + 1)) + 3;
            document.getElementById('spots-left').textContent = spots;

            // 2. DEVICE DETECTION: Highlight the best offer for the user
            const userAgent = navigator.userAgent.toLowerCase();
            const isAndroid = userAgent.includes('android');
            const isWindows = userAgent.includes('windows');
            const isMac = userAgent.includes('macintosh') || userAgent.includes('mac os x');
            const isLinux = userAgent.includes('linux');
            const isPC = isWindows || isMac || isLinux;

            const cards = document.querySelectorAll('.offer-card');
            
            cards.forEach(card => {
                const deviceType = card.getAttribute('data-device');
                let isRecommended = false;

                if (deviceType === 'all') {
                    // Recommend "All" if user is on iOS or unknown mobile
                    if (!isAndroid And !isPC) isRecommended = true;
                } else if (deviceType === 'android-pc') {
                    // Recommend "Android/PC" if user is on those devices
                    if (isAndroid || isPC) isRecommended = true;
                }

                if (isRecommended) {
                    card.classList.add('highlight');
                    const recBadge = document.createElement('div');
                    recBadge.className = 'recommended-badge';
                    recBadge.textContent = '🔥 Best for you';
                    card.appendChild(recBadge);
                }
            });

            // 3. SOCIAL PROOF: Fake recent claims notification
            const names = ["Alex M.", "Sarah K.", "John D.", "Emily R.", "Michael B.", "Jessica T.", "David W.", "Olivia P."];
            const actions = [
                "just claimed a $1000 CashApp Card!",
                "just claimed a $100 Nike Gift Card!",
                "completed the offer and got rewarded!"
            ];

            function showNotification() {
                const name = names[Math.floor(Math.random() * names.length)];
                const action = actions[Math.floor(Math.random() * actions.length)];
                
                const notif = document.createElement('div');
                notif.className = 'notification';
                notif.innerHTML = `<strong>✅ ${name}</strong><br/>${action}`;
                document.body.appendChild(notif);
                
                // Trigger animation
                setTimeout(() => notif.classList.add('show'), 100);
                
                // Remove after 4 seconds
                setTimeout(() => {
                    notif.classList.remove('show');
                    setTimeout(() => notif.remove(), 500);
                }, 4000);
            }

            // Show first notification after 3 seconds, then randomly every 8-15 seconds
            setTimeout(() => {
                showNotification();
                setInterval(showNotification, Math.random() * 7000 + 8000);
            }, 3000);
        });
    </script>
</body>
</html>